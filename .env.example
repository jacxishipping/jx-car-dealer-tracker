# Copy to .env (server) / .env.local (frontend) and fill in real values.
# NEVER commit a real .env — only this example file is tracked.
# Frontend: only VITE_API_URL is read by the app (Vite exposes VITE_* vars).
VITE_API_URL=http://localhost:3001

# Server
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
CORS_ORIGIN=http://localhost:5173
PORT=3001
